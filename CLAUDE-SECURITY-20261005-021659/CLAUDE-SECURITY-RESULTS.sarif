                  "startLine": 71,
                  "snippet": {
                    "text": "            return sub == null || !denyRead.contains(sub);"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "Devices.Device.canReadSub",
                  "fullyQualifiedName": "Devices.Device.canReadSub"
                }
              ]
            }
          ],
