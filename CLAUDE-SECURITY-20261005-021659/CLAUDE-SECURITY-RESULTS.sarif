                    "text": "try (var channel = Files.newByteChannel(file); OutputStream out = ex.getResponseBody()) {"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "sendFile",
                  "fullyQualifiedName": "sendFile"
                }
              ]
            }
          ],
          "properties": {
            "claudeSecurityPlugin": {
              "id": "F8",
